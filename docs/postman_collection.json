    {
      "name": "Progress",
      "item": [
        {
          "name": "Crear log de progreso (estudiante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exercise_id\": {{exercise_id}},\n  \"routine_id\": {{routine_id}},\n  \"reps\": 12,\n  \"sets\": 3,\n  \"weight_kg\": 30,\n  \"duration_seconds\": 900,\n  \"perceived_exertion\": 7,\n  \"notes\": \"Series controladas y buena técnica\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/progress/logs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "progress",
                "logs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.id) {\n    pm.collectionVariables.set(\"progress_log_id\", jsonData.id);\n}\n"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener log de progreso",
          "request": {
