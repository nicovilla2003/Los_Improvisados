  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{student_username}}\",\n  \"password\": \"{{student_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.access_token) {\n    pm.collectionVariables.set(\"student_token\", jsonData.access_token);\n}\n"
                ]
              }
            }
          ]
        },
        {
          "name": "Login instructor",
