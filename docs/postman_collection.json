        {
          "name": "Filtrar progreso por fecha y rutina",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/progress/students/{{student_id}}/logs?routine_id={{routine_id}}&start={{start_date}}&end={{end_date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "progress",
                "students",
                "{{student_id}}",
                "logs"
              ],
              "query": [
                {
                  "key": "routine_id",
                  "value": "{{routine_id}}"
                },
                {
                  "key": "start",
                  "value": "{{start_date}}"
                },
                {
                  "key": "end",
                  "value": "{{end_date}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});"
                ]
              }
            }
          ]
        }
      ]
